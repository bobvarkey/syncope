  "praxis_model": {
    "inputs": [
      "visual",
      "verbal-auditory",
      "tactile"
    ],
    "components": [
      "action semantics",
      "left inferior parietal movement formulas",
      "supplementary motor area motor programs",
      "primary motor cortex",
      "corpus callosum for contralateral motor programming"
    ],
    "note": "Schematic neuroanatomical model; handedness and lateralization vary."
  },
  "interpretation_rules": [
    "Assess both upper extremities independently.",
    "Distinguish spatiotemporal production errors from content errors.",
    "Use real-object performance to assess severity and compensatory improvement.",
    "Aphasia can confound command-based dissociation testing.",
    "Callosal apraxia can phenocopy disconnection, dissociation, or conceptual apraxia in the nondominant limb.",
    "Multiple apraxia subtypes may coexist.",
    "No numerical cutoff or validated scoring weights are provided in the chapter."
  ],
