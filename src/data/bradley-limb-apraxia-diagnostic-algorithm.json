    ]
  },
  "purpose": "Clinician-oriented structured decision support, not a validated diagnostic score",
  "source_fidelity_note": "Decision branching is an operational synthesis of chapter descriptions and Table 10.1, not a published validated flowchart. Some table cells are qualified by footnotes and narrative; profiles should be interpreted clinically.",
  "input_fields": [
    {
      "id": "pantomime",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "comb hair",
        "brush teeth",
        "flip coin",
        "use scissors",
        "use hammer",
        "use screwdriver",
        "wave goodbye",
        "beckon",
        "stop gesture",
        "salute",
        "hitchhike",
        "victory sign"
      ],
      "label": "Pantomime to verbal command",
      "assess_each_hand": true
    },
    {
      "id": "imitation",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "transitive gestures",
        "intransitive gestures"
      ],
      "label": "Imitate demonstrated gestures",
      "assess_each_hand": true
    },
    {
      "id": "gesture_knowledge",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "identify action",
        "distinguish correct from incorrect execution"
      ],
      "label": "Recognize and judge gesture correctness",
      "assess_each_hand": true
    },
    {
      "id": "sequencing",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "prepare letter for mailing",
        "make sandwich"
      ],
      "label": "Perform multistep sequences",
      "assess_each_hand": true
    },
    {
      "id": "tool_knowledge",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "select correct tool",
        "show correct action",
        "match tool to task"
      ],
      "label": "Demonstrate conceptual tool-object knowledge",
      "assess_each_hand": true
    },
    {
      "id": "fine_motor",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "finger tapping",
        "thumb-finger opposition",
        "pick up coin without sliding",
        "twirl coin"
      ],
      "label": "Assess limb kinetic movements",
      "assess_each_hand": true
    },
    {
      "id": "real_object",
      "type": "categorical",
      "options": [
        "normal",
        "abnormal",
        "not_tested",
        "uninterpretable"
      ],
      "task_examples": [
        "perform real object action"
      ],
      "label": "Use actual tools",
      "assess_each_hand": true
    },
    {
      "id": "error_type",
      "type": "multiselect",
      "options": [
        "spatiotemporal",
        "content",
        "unrecognizable",
        "sequence",
        "fine_dexterity",
        "body_part_as_object",
        "none"
      ]
    },
    {
      "id": "dominant_hand",
      "type": "enum",
      "options": [
        "right",
        "left",
        "ambidextrous",
        "unknown"
      ]
    },
    {
      "id": "language_comprehension",
      "type": "enum",
      "options": [
        "intact",
        "impaired",
        "uncertain"
      ]
    }
  ],
  "decision_nodes": [
    {
      "id": "start",
      "type": "question",
      "prompt": "Is there difficulty performing previously learned skilled limb movements?",
      "yes": "exclude_confounds",
      "no": "no_apraxia"
    },
    {
      "id": "exclude_confounds",
      "type": "question",
      "prompt": "Can the deficit be fully explained by weakness, spasticity, ataxia, extrapyramidal disturbance, primary sensory deficit, neglect, agnosia, visual disorder, involuntary movement, impaired attention, language comprehension or executive dysfunction?",
      "yes": "confounded",
      "no": "test_both_limbs"
    },
    {
      "id": "test_both_limbs",
      "type": "assessment",
      "instruction": "Perform the full praxis battery separately in dominant and nondominant hands; document each task and error type.",
      "next": "nondominant_only"
    },
    {
      "id": "nondominant_only",
      "type": "question",
      "prompt": "Is the abnormality restricted or markedly predominant in the nondominant hand?",
      "yes": "callosal_pattern",
      "no": "fine_motor_pattern"
    },
    {
      "id": "callosal_pattern",
      "type": "diagnostic_consideration",
      "diagnosis": "callosal",
      "instruction": "Compare command, imitation, tool knowledge and real-object use; consider callosal disconnection; unilateral pattern is not by itself diagnostic.",
      "next": "fine_motor_pattern"
    },
    {
      "id": "fine_motor_pattern",
      "type": "question",
      "prompt": "Are fine independent finger movements selectively impaired despite no sufficient weakness or tone abnormality?",
      "yes": "limb_kinetic",
      "no": "sequencing_pattern"
    },
    {
      "id": "sequencing_pattern",
      "type": "question",
      "prompt": "Are multistep actions incorrectly ordered while individual actions and tool knowledge remain intact?",
      "yes": "ideational",
      "no": "tool_pattern"
    },
    {
      "id": "tool_pattern",
      "type": "question",
      "prompt": "Are there content errors or incorrect tool-object/action associations?",
      "yes": "conceptual",
      "no": "modality_pattern"
    },
    {
      "id": "modality_pattern",
      "type": "question",
      "prompt": "Is gesture performance impaired only for a specific input modality, with preserved performance via other modalities?",
      "yes": "dissociation",
      "no": "ideomotor_pattern"
    },
    {
      "id": "ideomotor_pattern",
      "type": "question",
      "prompt": "Are both pantomime to command and imitation impaired by spatial or temporal production errors?",
      "yes": "recognition_pattern",
      "no": "indeterminate"
    },
    {
      "id": "recognition_pattern",
      "type": "question",
      "prompt": "Is gesture recognition or discrimination also impaired?",
      "yes": "ideomotor_parietal",
      "no": "ideomotor_disconnection"
    },
    {
      "id": "ideomotor_parietal",
      "type": "terminal_candidate",
      "diagnosis": "ideomotor_parietal",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "ideomotor_disconnection",
      "type": "terminal_candidate",
      "diagnosis": "ideomotor_disconnection",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "dissociation",
      "type": "terminal_candidate",
      "diagnosis": "dissociation",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "ideational",
      "type": "terminal_candidate",
      "diagnosis": "ideational",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "conceptual",
      "type": "terminal_candidate",
      "diagnosis": "conceptual",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "limb_kinetic",
      "type": "terminal_candidate",
      "diagnosis": "limb_kinetic",
      "action": "Review complete examination profile and evaluate underlying cause; do not assign diagnosis from a single test."
    },
    {
      "id": "confounded",
      "type": "terminal",
      "result": "Primary motor/sensory/cognitive deficit may explain findings; treat or account for confound and reassess."
    },
    {
      "id": "no_apraxia",
      "type": "terminal",
      "result": "No limb praxis deficit established."
    },
    {
      "id": "indeterminate",
      "type": "terminal",
      "result": "Mixed or atypical pattern; assess all domains, consider comorbidity and specialist neuropsychological evaluation."
    }
  ],
  "diagnostic_profiles": {
    "ideomotor_parietal": {
